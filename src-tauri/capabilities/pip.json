{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pip",
  "description": "Picture-in-picture windows: only what pip.js needs (play video, move/resize/close itself). The one app command it calls is get_live_m3u8_url; no updater, restart, autostart, notifications, links or new windows",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "pip",
    "pip-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "allow-get-live-m3u8-url",
    "core:webview:deny-internal-toggle-devtools"
  ]
}
